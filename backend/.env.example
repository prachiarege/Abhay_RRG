# Copy to .env and edit. All settings are optional; defaults are in app/config.py.
# Every operational parameter is here so that normal changes need no code edit (SRS 40).

# --- data source ---------------------------------------------------------
# yahoo | csv | nse   (see app/providers/ - yahoo is dev-only, see licensing note)
RRG_DATA_PROVIDER=yahoo
RRG_HISTORY_YEARS=12

# --- database ------------------------------------------------------------
# SQLite by default. For production:
# RRG_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/rrg
# RRG_DATABASE_URL=sqlite:///./data/rrg.db

# --- engine defaults (SRS 51) -------------------------------------------
RRG_DEFAULT_BENCHMARK=NIFTY500
RRG_DEFAULT_FREQUENCY=weekly
RRG_DEFAULT_TAIL_LENGTH=10
RRG_RS_PERIOD=14
RRG_MOMENTUM_PERIOD=10
RRG_SMOOTHING_PERIOD=5
RRG_SMOOTHING_METHOD=sma
RRG_QUADRANT_CENTER=100.0

# --- api -----------------------------------------------------------------
RRG_CORS_ORIGINS=http://localhost:3000
# RRG_API_KEY=set-me-to-require-x-api-key-on-mutating-endpoints

# --- refresh (SRS 29) ----------------------------------------------------
RRG_AUTO_REFRESH_ENABLED=false
RRG_REFRESH_HOUR_IST=18
RRG_REFRESH_MINUTE_IST=30
